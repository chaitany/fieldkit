# ---- AI mapping (local / private deployments only) ------------------------
# Used for local dev, the CLI, or a private deployment inside a customer network.
# IGNORED when FIELDKIT_DEMO_MODE=1: public visitors bring their own key instead.
# Do not set this on a public host.
# ANTHROPIC_API_KEY=
# Corporate LLM gateway / proxy (optional)
# ANTHROPIC_BASE_URL=https://llm-gateway.internal.example.com
# FIELDKIT_MODEL=claude-sonnet-5-5

# ---- Public demo mode ---------------------------------------------------
# Turn on for any internet-facing deployment.
FIELDKIT_DEMO_MODE=1
# Advanced, off by default: let a public demo spend a hosted key (sample-only, cached, quota-limited).
# Leave unset to keep the demo bring-your-own-key only.
# FIELDKIT_ALLOW_HOSTED_AI=1
# FIELDKIT_HOSTED_SAMPLE_ONLY=1
# FIELDKIT_AI_PER_VISITOR_DAILY=5
# FIELDKIT_AI_GLOBAL_DAILY=100
# General API rate limit per visitor (all POST routes).
FIELDKIT_REQUESTS_PER_MINUTE=30
# Upload cap in bytes (demo default 2MB).
FIELDKIT_MAX_CSV_BYTES=2097152
# Salt for hashing visitor IPs (raw IPs are never stored).
FIELDKIT_VISITOR_SALT=change-me

# ---- Storage --------------------------------------------------------------
# Audit log path. Auto-detects /tmp on Vercel/Lambda.
# FIELDKIT_AUDIT=/data/audit.jsonl
